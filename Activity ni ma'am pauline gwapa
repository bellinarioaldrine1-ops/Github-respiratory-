import java.util.Scanner;

public class RecursiveGCD {

    // Recursive method for finding the GCD
    public static long gcdRecursive(long a, long b) {

        // Display the current recursive call
        System.out.print("gcd(" + a + ", " + b + ")");

        // Base case
        if (b == 0) {
            System.out.println(" -> " + a + " (base case)");
            return a;
        }

        // Show the remainder
        System.out.println(", a % b = " + (a % b));

        // Recursive call
        return gcdRecursive(b, a % b);
    }

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        // Get first input
        System.out.print("Enter first non-negative integer: ");
        long a = input.nextLong();

        // Get second input
        System.out.print("Enter second non-negative integer: ");
        long b = input.nextLong();

        // Check for negative numbers
        if (a < 0 || b < 0) {
            System.out.println("Please enter non-negative integers only.");
            input.close();
            return;
        }

        // Check if both inputs are zero
        if (a == 0 && b == 0) {
            System.out.println("The two inputs must not both be zero.");
            input.close();
            return;
        }

        // Display recursion trace
        System.out.println("\nRecursion trace:");

        long result = gcdRecursive(a, b);

        // Display final result
        System.out.println("GCD = " + result);

        input.close();
    }
}
